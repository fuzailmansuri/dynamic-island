+@Composable
+fun AudioWaveformVisualizer(
+    isPlaying: Boolean,
+    color: Color,
+    modifier: Modifier = Modifier.size(width = 14.dp, height = 12.dp),
+    barCount: Int = 4,
+) {
+    val phaseState: State<Float>?
+    if (isPlaying) {
+        val transition = rememberInfiniteTransition(label = "audio_wave_transition")
+        phaseState = transition.animateFloat(
+            initialValue = 0f,
+            targetValue = (2f * PI).toFloat(),
+            animationSpec = infiniteRepeatable(
+                tween(720, easing = LinearEasing),
+                RepeatMode.Restart,
+            ),
+            label = "audio_wave_phase",
+        )
+    } else {
+        phaseState = null
+    }
+
+    val playRatio by animateFloatAsState(
+        targetValue = if (isPlaying) 1f else 0f,
+        animationSpec = tween(350, easing = FastOutSlowInEasing),
+        label = "audio_wave_ratio",
+    )
+
+    Canvas(modifier = modifier) {
+        val phase = phaseState?.value ?: 0f
+        val w = size.width
+        val h = size.height
+        val barW = (w / (barCount * 1.8f)).coerceAtLeast(1.5.dp.toPx())
+        val totalBarsW = barCount * barW
+        val gap = ((w - totalBarsW) / (barCount - 1).coerceAtLeast(1)).coerceAtLeast(1.dp.toPx())
+        val minH = 2.2.dp.toPx()
+        val maxH = (h * 0.95f).coerceAtLeast(minH)
+
+        val freqMultipliers = floatArrayOf(1.0f, 1.7f, 1.3f, 1.9f)
+        val phaseOffsets = floatArrayOf(0.0f, 1.3f, 2.7f, 0.8f)
+
+        for (i in 0 until barCount) {
+            val freq = freqMultipliers.getOrElse(i) { 1f }
+            val pOffset = phaseOffsets.getOrElse(i) { 0f }
+            val rawSine = (sin(phase * freq + pOffset) + 1f) / 2f
+            val harmonic = (cos(phase * freq * 0.5f + pOffset) + 1f) / 4f
+            val dynamicFactor = (rawSine * 0.75f + harmonic).coerceIn(0.15f, 1.0f)
+
+            val liveH = minH + (maxH - minH) * dynamicFactor
+            val barH = minH + (liveH - minH) * playRatio
+            val x = i * (barW + gap) + barW / 2f
+            val yTop = (h - barH) / 2f
+            val yBottom = yTop + barH
+
+            drawLine(
+                color = color,
+                start = Offset(x, yTop),
+                end = Offset(x, yBottom),
+                strokeWidth = barW,
+                cap = StrokeCap.Round,
+            )
+        }
+    }
+}
