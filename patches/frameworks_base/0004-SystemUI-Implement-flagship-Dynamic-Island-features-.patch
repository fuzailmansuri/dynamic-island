+    private fun getChargingSpeedInfo(): Pair<Boolean, String?> {
+        return try {
+            val batteryIntent = context.registerReceiver(null, IntentFilter(Intent.ACTION_BATTERY_CHANGED))
+            if (batteryIntent != null) {
+                val status = BatteryStatus(batteryIntent)
+                val isFast = status.getChargingSpeed(context) == BatteryStatus.CHARGING_FAST
+                val label = when {
+                    batteryController.isWirelessCharging -> "Wireless Charging"
+                    isFast -> "Fast Charging"
+                    else -> "Charging"
+                }
+                Pair(isFast, label)
+            } else {
+                Pair(false, if (batteryController.isWirelessCharging) "Wireless Charging" else "Charging")
+            }
+        } catch (_: Exception) {
+            Pair(false, if (batteryController.isWirelessCharging) "Wireless Charging" else "Charging")
+        }
+    }
+
     fun stopCharging() {
         if (!chargingListening) return
         chargingListening = false
