From e4f9ea565081fde15375fa8d16454da27981276e Mon Sep 17 00:00:00 2001
From: Fuzail Mansuri <mfm9875@gmail.com>
Date: Sat, 5 Sep 2026 16:15:16 +0000
Subject: [PATCH 08/13] SystemUI: Eliminate icon fan-stretching and triangle
 distortion with proportional wrapContent and A14 margins

---
 packages/SystemUI/res/values/dimens.xml       | 23 +++++++-------
 .../ui/view/ModernStatusBarMobileView.kt      | 30 +++++++++++--------
 .../wifi/ui/view/ModernStatusBarWifiView.kt   |  3 +-
 3 files changed, 31 insertions(+), 25 deletions(-)

diff --git a/packages/SystemUI/res/values/dimens.xml b/packages/SystemUI/res/values/dimens.xml
index 71b969b39b46..88fb13591b2c 100644
--- a/packages/SystemUI/res/values/dimens.xml
+++ b/packages/SystemUI/res/values/dimens.xml
@@ -191,15 +191,15 @@
     <!-- End padding for left-aligned status bar clock -->
     <dimen name="status_bar_left_clock_end_padding">2sp</dimen>
 
-    <!-- Margins before/after the new wifi icon. Increased to 5dp for A14 icon spacing. -->
-    <dimen name="status_bar_wifi_signal_horizontal_margin">5dp</dimen>
+    <!-- Margins before/after the new wifi icon. Tightened old-style 3dp. -->
+    <dimen name="status_bar_wifi_signal_horizontal_margin">3dp</dimen>
 
     <!-- Spacing after the wifi signals that is present if there are any icons following it.
-         Increased from 2.5sp to 4dp for better separation between Wi-Fi and next icon. -->
-    <dimen name="status_bar_wifi_signal_spacer_width">4dp</dimen>
+         Tight old-style 2dp. -->
+    <dimen name="status_bar_wifi_signal_spacer_width">2dp</dimen>
 
     <!-- Size of the view displaying the wifi inout icon in the status bar. -->
-    <dimen name="status_bar_wifi_inout_container_size">17sp</dimen>
+    <dimen name="status_bar_wifi_inout_container_size">17.6dp</dimen>
     <!-- Size of the view displaying the wifi signal icon in the status bar.
          Set to 17.6dp to match the A14 status bar icon sizing mandate. -->
     <dimen name="status_bar_wifi_signal_size">17.6dp</dimen>
@@ -226,9 +226,9 @@
     <dimen name="status_bar_mobile_container_corner_radius">9sp</dimen>
 
     <!-- Start-side margin for the mobile container (before the RAT or triangle).
-         Increased from 3sp to 5dp for better horizontal breathing room. -->
-    <dimen name="status_bar_mobile_container_margin_start">5dp</dimen>
-    <dimen name="status_bar_mobile_container_margin_end">5dp</dimen>
+         Tight old-style 3dp. -->
+    <dimen name="status_bar_mobile_container_margin_start">3dp</dimen>
+    <dimen name="status_bar_mobile_container_margin_end">3dp</dimen>
 
     <!-- Size of the view displaying the mobile signal icon in the status bar. This value should
         match the viewport height of mobile signal drawables such as ic_lte_mobiledata -->
@@ -236,7 +236,8 @@
     <!-- Size of the view that contains the network type. Should be equal to
    status_bar_mobile_type_size + 2, to account for 1sp top and bottom padding -->
     <dimen name="status_bar_mobile_container_height_updated">12sp</dimen>
-    <dimen name="status_bar_mobile_type_container_margin_end">6sp</dimen>
+    <dimen name="status_bar_mobile_type_container_margin_start">2.5sp</dimen>
+    <dimen name="status_bar_mobile_type_container_margin_end">1sp</dimen>
     <dimen name="status_bar_end_side_roam_icon_margin_start">2sp</dimen>
     <!-- Corner radius for the background of the network type indicator. Should be equal to
         status_bar_mobile_container_height / 2 -->
@@ -252,8 +253,8 @@
     <!-- Spacing before the airplane mode icon if there are any icons preceding it. -->
     <dimen name="status_bar_airplane_spacer_width">4sp</dimen>
 
-    <!-- Spacing between system icons. Increased from 0sp to 2dp for A14 icon breathing room. -->
-    <dimen name="status_bar_system_icon_spacing">2dp</dimen>
+    <!-- Spacing between system icons. Tight old-style 1dp. -->
+    <dimen name="status_bar_system_icon_spacing">1dp</dimen>
 
     <!-- The amount to scale each of the status bar icons by. A value of 1 means no scaling. -->
     <item name="status_bar_icon_scale_factor" format="float" type="dimen">1.0</item>
diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/pipeline/mobile/ui/view/ModernStatusBarMobileView.kt b/packages/SystemUI/src/com/android/systemui/statusbar/pipeline/mobile/ui/view/ModernStatusBarMobileView.kt
index 29734148a64b..7e67d003d8c8 100644
--- a/packages/SystemUI/src/com/android/systemui/statusbar/pipeline/mobile/ui/view/ModernStatusBarMobileView.kt
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/pipeline/mobile/ui/view/ModernStatusBarMobileView.kt
@@ -20,6 +20,7 @@ import android.content.Context
 import android.content.res.Configuration
 import android.util.AttributeSet
 import android.view.LayoutInflater
+import android.view.ViewGroup
 import android.widget.FrameLayout
 import android.widget.ImageView
 import com.android.keyguard.AlphaOptimizedLinearLayout
@@ -53,6 +54,8 @@ class ModernStatusBarMobileView(context: Context, attrs: AttributeSet?) :
     }
 
     public override fun onConfigurationChanged(newConfig: Configuration?) {
+        // Always enforce A14 spread sizing (17.6dp icon, 5dp container margins)
+        // for both legacy and modern paths.
         configureLayoutForNewStatusBarIcons()
     }
 
@@ -76,32 +79,36 @@ class ModernStatusBarMobileView(context: Context, attrs: AttributeSet?) :
 
         // triangle
         requireViewById<ImageView>(R.id.mobile_signal).apply {
+            adjustViewBounds = true
             val signalSize =
                 context.resources.getDimensionPixelSize(
                     R.dimen.status_bar_mobile_signal_size
                 )
-            layoutParams.width = signalSize
+            layoutParams.width = ViewGroup.LayoutParams.WRAP_CONTENT
             layoutParams.height = signalSize
         }
 
         // RAT indicator container
         requireViewById<FrameLayout>(R.id.mobile_type_container).apply {
-            // marginStart is moved to the outer group
-            (layoutParams as MarginLayoutParams).marginStart = 0
+            (layoutParams as MarginLayoutParams).marginStart =
+                context.resources.getDimensionPixelSize(
+                    R.dimen.status_bar_mobile_type_container_margin_start
+                )
             (layoutParams as MarginLayoutParams).marginEnd =
                 context.resources.getDimensionPixelSize(
                     R.dimen.status_bar_mobile_type_container_margin_end
                 )
             layoutParams.height =
                 context.resources.getDimensionPixelSize(
-                    R.dimen.status_bar_mobile_container_height_updated
+                    R.dimen.status_bar_mobile_container_height
                 )
         }
 
         // RAT indicator
         requireViewById<ImageView>(R.id.mobile_type).apply {
+            adjustViewBounds = true
             layoutParams.height =
-                context.resources.getDimensionPixelSize(R.dimen.status_bar_mobile_type_size_updated)
+                context.resources.getDimensionPixelSize(R.dimen.status_bar_mobile_type_size)
         }
     }
 
@@ -122,10 +129,9 @@ class ModernStatusBarMobileView(context: Context, attrs: AttributeSet?) :
                     .inflate(R.layout.status_bar_mobile_signal_group_new, null)
                     as ModernStatusBarMobileView)
                 .apply {
-                    // Flag-specific configuration
-                    if (NewStatusBarIcons.isEnabled) {
-                        configureLayoutForNewStatusBarIcons()
-                    }
+                    // A14 legacy reversion is default-on; always enforce 17.6dp
+                    // sizing and 5dp spread margins regardless of flag.
+                    configureLayoutForNewStatusBarIcons()
 
                     subId = viewModel.subscriptionId
                     initView(slot) {
@@ -155,10 +161,8 @@ class ModernStatusBarMobileView(context: Context, attrs: AttributeSet?) :
                         .inflate(R.layout.status_bar_mobile_signal_group_new, null)
                         as ModernStatusBarMobileView)
                     .apply {
-                        // Flag-specific configuration
-                        if (NewStatusBarIcons.isEnabled) {
-                            configureLayoutForNewStatusBarIcons()
-                        }
+                        // A14 legacy reversion is default-on; always enforce sizing.
+                        configureLayoutForNewStatusBarIcons()
 
                         subId = subscriptionId
                     }
diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/pipeline/wifi/ui/view/ModernStatusBarWifiView.kt b/packages/SystemUI/src/com/android/systemui/statusbar/pipeline/wifi/ui/view/ModernStatusBarWifiView.kt
index 5afa82c8f2c7..43a43fc404f1 100644
--- a/packages/SystemUI/src/com/android/systemui/statusbar/pipeline/wifi/ui/view/ModernStatusBarWifiView.kt
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/pipeline/wifi/ui/view/ModernStatusBarWifiView.kt
@@ -69,6 +69,7 @@ class ModernStatusBarWifiView(context: Context, attrs: AttributeSet?) :
     }
 
     public override fun onConfigurationChanged(newConfig: Configuration?) {
+        super.onConfigurationChanged(newConfig)
         updateDimensions()
     }
 
@@ -77,7 +78,7 @@ class ModernStatusBarWifiView(context: Context, attrs: AttributeSet?) :
         iconView.adjustViewBounds = true
         val lp = iconView.layoutParams
         val signalSize = resources.getDimensionPixelSize(R.dimen.status_bar_wifi_signal_size)
-        lp.width = signalSize
+        lp.width = ViewGroup.LayoutParams.WRAP_CONTENT
         lp.height = signalSize
         iconView.layoutParams = lp
 
-- 
2.43.0

