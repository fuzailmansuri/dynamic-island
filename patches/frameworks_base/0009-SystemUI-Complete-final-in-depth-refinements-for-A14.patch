@@ -7322,6 +7322,15 @@ public final class Settings {
         @Readable
         public static final String STATUS_BAR_BATTERY_STYLE = "status_bar_battery_style";
 
+        /**
+         * Whether to use legacy (Android 14) status bar icons.
+         * 0 = modern icons
+         * 1 = legacy icons (default)
+         * @hide
+         */
