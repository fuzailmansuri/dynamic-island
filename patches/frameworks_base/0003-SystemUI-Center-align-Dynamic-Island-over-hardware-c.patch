+++ b/packages/SystemUI/src/com/android/systemui/axdynamicbar/ui/compose/AxDynamicBarChip.kt
@@ -223,17 +223,19 @@ private fun AxDynamicBarChipContent(
                 label = "content",
             )
             val progress = chipProgressFor(event)
+            val cutoutType by viewModel.cutoutType.collectAsStateWithLifecycle()
             val cutoutWidthSetting by viewModel.cutoutWidth.collectAsStateWithLifecycle()
             val cutoutHeightSetting by viewModel.cutoutHeight.collectAsStateWithLifecycle()
             val cutoutOffsetXSetting by viewModel.cutoutOffsetX.collectAsStateWithLifecycle()
             val cutoutOffsetYSetting by viewModel.cutoutOffsetY.collectAsStateWithLifecycle()
 
-            val chipHeightDp = if (cutoutHeightSetting > 0) cutoutHeightSetting.dp else ChipHeight
-            val chipMinWidthDp = if (cutoutWidthSetting > 0) cutoutWidthSetting.dp else Dp.Unspecified
+            val chipHeightDp = (ChipHeight.value + cutoutHeightSetting).coerceAtLeast(16f).dp
+            val chipMinWidthDp = if (cutoutWidthSetting != 0) (48f + cutoutWidthSetting).coerceAtLeast(24f).dp else Dp.Unspecified
+            val chipMaxWidthDp = (140f + cutoutWidthSetting).coerceAtLeast(60f).dp
 
             Box(
                 modifier = Modifier.fillMaxHeight(),
-                contentAlignment = Alignment.Center,
+                contentAlignment = if (cutoutType == "left") Alignment.CenterStart else Alignment.Center,
             ) {
                 Box(
                     modifier =
@@ -254,7 +256,7 @@ private fun AxDynamicBarChipContent(
