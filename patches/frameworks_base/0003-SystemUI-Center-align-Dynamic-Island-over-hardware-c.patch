                             Modifier.height(chipHeightDp)
-                                .widthIn(min = chipMinWidthDp, max = 120.dp)
+                                .widthIn(min = chipMinWidthDp, max = chipMaxWidthDp)
                                 .offset(x = cutoutOffsetXSetting.dp, y = cutoutOffsetYSetting.dp)
                                 .then(chipVisibilityModifier)
                                 .clip(ChipShape)
