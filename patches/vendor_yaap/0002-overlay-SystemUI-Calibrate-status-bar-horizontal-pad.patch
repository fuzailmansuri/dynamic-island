 1 file changed, 4 insertions(+)

diff --git a/overlay/SystemUIOverlay/res/values/dimens.xml b/overlay/SystemUIOverlay/res/values/dimens.xml
index ae1e6fb..a4692df 100644
--- a/overlay/SystemUIOverlay/res/values/dimens.xml
+++ b/overlay/SystemUIOverlay/res/values/dimens.xml
@@ -17,4 +17,8 @@
 <resources>
     <!-- Remove power menu shadow -->
     <dimen name="global_actions_translate">0dp</dimen>
+
+    <!-- Status bar padding -->
+    <dimen name="status_bar_padding_start">16dp</dimen>
+    <dimen name="status_bar_padding_end">16dp</dimen>
 </resources>
