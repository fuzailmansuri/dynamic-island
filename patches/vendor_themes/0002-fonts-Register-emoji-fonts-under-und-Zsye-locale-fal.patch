From 9b5080ba15a306049fdfbc19c384017830207a47 Mon Sep 17 00:00:00 2001
From: Fuzail Mansuri <mfm9875@gmail.com>
Date: Sat, 5 Sep 2026 19:53:13 +0000
Subject: [PATCH 2/2] fonts: Register emoji fonts under und-Zsye locale
 fallback

---
 fonts/fonts_customization.xml | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/fonts/fonts_customization.xml b/fonts/fonts_customization.xml
index e8fbd47..95728a1 100644
--- a/fonts/fonts_customization.xml
+++ b/fonts/fonts_customization.xml
@@ -881,4 +881,25 @@
         <font weight="400" style="normal">FluentColorEmoji.ttf</font>
     </family>
     <alias name="fluent" to="fluent-emoji" />
+
+    <!-- Emoji locale fallback entries for Minikin resolution -->
+    <family customizationType="new-locale-family" operation="prepend" lang="und-Zsye">
+        <font weight="400" style="normal">AppleColorEmoji.ttf</font>
+    </family>
+
+    <family customizationType="new-locale-family" operation="prepend" lang="und-Zsye">
+        <font weight="400" style="normal">SamsungColorEmoji.ttf</font>
+    </family>
+
+    <family customizationType="new-locale-family" operation="prepend" lang="und-Zsye">
+        <font weight="400" style="normal">TwemojiColorEmoji.ttf</font>
+    </family>
+
+    <family customizationType="new-locale-family" operation="prepend" lang="und-Zsye">
+        <font weight="400" style="normal">JoyPixelsColorEmoji.ttf</font>
+    </family>
+
+    <family customizationType="new-locale-family" operation="prepend" lang="und-Zsye">
+        <font weight="400" style="normal">FluentColorEmoji.ttf</font>
+    </family>
 </fonts-modification>
